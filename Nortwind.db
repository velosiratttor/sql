<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/03 Lab 2 PC 18/Desktop/Nortwind/Nortwind.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2098"/><column_width id="4" width="0"/><expanded_item id="1" parent="0"/><expanded_item id="3" parent="0"/><expanded_item id="4" parent="0"/><expanded_item id="5" parent="0"/><expanded_item id="7" parent="0"/><expanded_item id="0" parent="1"/><expanded_item id="5" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Categories" custom_title="0" dock_id="1" table="4,10:mainCategories"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011700ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Categories" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="82"/><column index="2" value="119"/><column index="3" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">--Parte 1
----------------------------------------------------------------------------------------------------------------------------------
1- select CategoryID , (select ProductName from Products where Products.CategoryID = Categories.CategoryID)as Productos , CategoryName as Categoria 
	from Categories where CategoryName in ('Beverages')
----------------------------------------------------------------------------------------------------------------------------------
2- select CustomerName as Clientes , (select CustomerID from Orders where Orders.CustomerID = Customers.CustomerID) as Id_Pedidos from Customers
----------------------------------------------------------------------------------------------------------------------------------
3- select FirstName as Empleados ,LastName as Apellido , 
	(select EmployeeID from Orders where Orders.EmployeeID = Employees.EmployeeID) as Id_Pedidos from Employees
----------------------------------------------------------------------------------------------------------------------------------
4- select ProductName as Productos , avg(Price) as Promedio_Precio from Products order by Promedio_Precio desc
----------------------------------------------------------------------------------------------------------------------------------
5- select CustomerID ,  CustomerName as Clientes , (select CustomerID from Orders where Orders.CustomerID = Customers.CustomerID) as Id_Pedidos  , 
	(select OrderDate  from Orders where Orders.CustomerID = Customers.CustomerID and OrderDate LIKE '1997%') as Fecha_Pedido from Customers
----------------------------------------------------------------------------------------------------------------------------------
6- SELECT CategoryName as Categorias , 
(select(SELECT SupplierName from Suppliers where Suppliers.SupplierID = Products.SupplierID) from Products ) as Proveedores
FROM Categories	where Categorias in ('Confections')
----------------------------------------------------------------------------------------------------------------------------------
7- select ProductName as Productos , (Select CategoryName from Categories where Categories.CategoryID = Products.CategoryID) as categoria 
	from Products where categoria in ('Confections')
----------------------------------------------------------------------------------------------------------------------------------
8- select FirstName As Nombre_Empleado , LastName as Apellido from Employees --No hay empleados con apellido igual que el otro
----------------------------------------------------------------------------------------------------------------------------------
9- select (SELECT (SELECT(select CustomerName from Customers where Customers.CustomerID = Orders.CustomerID)from Orders)from OrderDetails where OrderDetails.ProductID = Products.ProductID) as Clientes,
		ProductName as Productos, Max(Price) as Precio
	from Products
----------------------------------------------------------------------------------------------------------------------------------
10-
SELECT ProductName AS Productos,(SELECT SupplierName FROM Suppliers WHERE Suppliers.SupplierID = Products.SupplierID) AS Proveedor,
    (SELECT City FROM Suppliers WHERE SupplierID = Products.SupplierID AND 
    City = (SELECT City FROM Customers WHERE Customers.City = Suppliers.City )) AS Ciudad FROM Products
WHERE Products.SupplierID IN (SELECT SupplierID FROM Suppliers WHERE City IN (SELECT City FROM Customers))
----------------------------------------------------------------------------------------------------------------------------------

</sql><sql name="SQL 2">--Parte2
----------------------------------------------------------------------------------------------------------------------------------
select OrderDetailID , (select(select CustomerName from Customers where Customers.CustomerID = Orders.CustomerID) from Orders 
where OrderID = OrderDetails.OrderID) as Clientes , Quantity as Cantidad from OrderDetails GROUP by Clientes
----------------------------------------------------------------------------------------------------------------------------------
select (Select ProductName from Products where Products.CategoryID = Categories.CategoryID ) as Productos  , CategoryName  as categoria 
from Categories limit 10
----------------------------------------------------------------------------------------------------------------------------------
select OrderID as Ordenes ,(select FirstName from Employees where Employees.EmployeeID = Orders.EmployeeID) as Empleado , 
(select Quantity from OrderDetails where OrderDetails.OrderID = Orders.OrderID) as Cantidad from Orders
where Cantidad &gt; 50
----------------------------------------------------------------------------------------------------------------------------------
select ProductName as Productos , (select CategoryName from Categories where Categories.CategoryID = Products.CategoryID ) 
as Categoria  , avg(Price) as Precio_Mayor_Promedio from Products
----------------------------------------------------------------------------------------------------------------------------------

SELECT CustomerID AS ID_Cliente, CustomerName AS Cliente FROM Customers 
WHERE (SELECT COUNT(*) FROM Orders WHERE Orders.CustomerID = Customers.CustomerID) &gt; 5
----------------------------------------------------------------------------------------------------------------------------------
select ProductName as Productos , (select Quantity from OrderDetails where OrderDetails.ProductID = Products.ProductID ) as Cantidad 
from Products  order by Cantidad desc
----------------------------------------------------------------------------------------------------------------------------------
select count(CustomerID) as Clientes,  City from Customers GROUP by City having Clientes &gt; 5
----------------------------------------------------------------------------------------------------------------------------------
SELECT SupplierID AS ID_Proveedor, SupplierName AS Proveedor FROM Suppliers 
WHERE (SELECT COUNT(*) FROM Products WHERE Products.SupplierID = Suppliers.SupplierID) &gt; 3
----------------------------------------------------------------------------------------------------------------------------------
SELECT EmployeeID AS ID_Empleado, FirstName AS Nombre, LastName AS Apellido, 
(SELECT COUNT(*) FROM Orders WHERE Orders.EmployeeID = Employees.EmployeeID) AS Total_Pedidos
FROM Employees WHERE (SELECT COUNT(*) FROM Orders WHERE Orders.EmployeeID = Employees.EmployeeID) &gt; (SELECT AVG(EmployeeID)from Orders )
----------------------------------------------------------------------------------------------------------------------------------
SELECT (select CategoryName from Categories where Categories.CategoryID = Products.CategoryID) as Categoria ,
 avg(Price) as PrecioPromedio FROM Products
----------------------------------------------------------------------------------------------------------------------------------

 


</sql><sql name="SQL 3">--Parte 3
----------------------------------------------------------------------------------------------------------------------------------
SELECT OrderID AS ID_Pedido, CustomerID AS ID_Cliente, OrderDate AS Fecha_Pedido FROM Orders 
WHERE OrderDate BETWEEN '1995-01-01' AND '1997-12-31' AND CustomerID IN (SELECT CustomerID FROM Customers WHERE Country = 'USA')
----------------------------------------------------------------------------------------------------------------------------------
SELECT EmployeeID AS ID_Empleado,FirstName AS Nombre,LastName AS Apellido FROM Employees 
WHERE EmployeeID IN (SELECT EmployeeID FROM Orders WHERE OrderDate like '1997_%') --No hay fechas 1998 se cambio a 1997
----------------------------------------------------------------------------------------------------------------------------------
SELECT CustomerID AS ID_Cliente, CustomerName AS Nombre_Cliente , (SELECT OrderDate from Orders 
where Orders.CustomerID = Customers.CustomerID and  OrderDate like '_____01_%' or OrderDate like '_____02_%') as Fecha FROM Customers 
----------------------------------------------------------------------------------------------------------------------------------
SELECT ProductName as Productos , Price as Precio from Products where Precio BETWEEN 10 and 50 order by Price desc
----------------------------------------------------------------------------------------------------------------------------------
SELECT EmployeeID AS ID_Empleado,FirstName AS Nombre,LastName AS Apellido
FROM Employees WHERE EmployeeID BETWEEN 3 AND 7 AND EmployeeID IN (SELECT DISTINCT EmployeeID FROM Orders)
----------------------------------------------------------------------------------------------------------------------------------
Select SupplierName , Country FROM Suppliers where Country in ('Germany', 'France', 'UK')
----------------------------------------------------------------------------------------------------------------------------------
select CategoryID , ProductName from Products where CategoryID in (2,4,6)
----------------------------------------------------------------------------------------------------------------------------------
select CustomerName , PostalCode from Customers where PostalCode BETWEEN 10000 and 20000
----------------------------------------------------------------------------------------------------------------------------------
SELECT ProductName AS Producto FROM Products WHERE ProductID IN (SELECT ProductID FROM OrderDetails WHERE OrderID BETWEEN 10250 AND 10300)
----------------------------------------------------------------------------------------------------------------------------------
SELECT EmployeeID AS ID_Empleado, FirstName AS Nombre, LastName AS Apellido from Employees
WHERE FirstName IN ('Nancy', 'Margaret', 'Robert');

</sql><sql name="SQL 6*">--Parte 4
----------------------------------------------------------------------------------------------------------------------------------
select * from Orders ORDER by CustomerID desc
----------------------------------------------------------------------------------------------------------------------------------
select ProductName as Productos , (select CategoryName from Categories where Categories.CategoryID = Products.CategoryID) as Categoria
, Price as Precio from Products group by Categoria order by Precio desc
----------------------------------------------------------------------------------------------------------------------------------
select (select FirstName from Employees as E where E.EmployeeID = O.EmployeeID ) as Empleados , count(EmployeeID) as Pedidos from Orders as O 
where  O.EmployeeID in(select EmployeeID from Employees) group by O.EmployeeID order by Pedidos desc
----------------------------------------------------------------------------------------------------------------------------------
select (select CategoryName from Categories as C where C.CategoryID = P.CategoryID ) as Categorias ,  count(ProductName) as Productos 
 from Products as P where P.CategoryID in(select CategoryID from Categories) group by Categorias order by Productos desc
 ----------------------------------------------------------------------------------------------------------------------------------
select SupplierName as Proveedor , (select count(ProductID) from Products as P where P.SupplierID = S.SupplierID) as Productos 
from Suppliers as S group by Proveedor order by Productos desc
----------------------------------------------------------------------------------------------------------------------------------
select (select CustomerName from Customers as C where C.CustomerID = O.CustomerID ) as Clientes ,  OrderDate as Fecha from Orders as O
GROUP by Clientes order by Orderdate desc
----------------------------------------------------------------------------------------------------------------------------------
select ProductName as Productos ,  (select count(Quantity) from OrderDetails as O wherE O.ProductID = P.ProductID)as Cantidad_Vendida 
from  Products as P group by Productos order by Cantidad_Vendida desc
----------------------------------------------------------------------------------------------------------------------------------
select (select CustomerName from Customers as C where C.CustomerID = O.CustomerID) as Clientes , Count(CustomerID) as Pedidos ,
(select Country from Customers as C where C.CustomerID = O.CustomerID) as Pais
 from Orders as O where O.CustomerID in (select CustomerID from Customers where Country in ('France'))group by O.CustomerID , Pais
 order by Pedidos desc
----------------------------------------------------------------------------------------------------------------------------------
select FirstName as Nombre_Empleado, (select Count(O.OrderID) from Orders as O where O.EmployeeID = E.EmployeeID and O.OrderDate like '1997%' ) as Pedidos
,(select OrderDate from Orders where OrderDate like '1997_%' ) as Fecha
from Employees as E  group by Pedidos order by Pedidos desc
----------------------------------------------------------------------------------------------------------------------------------
select   City as Ciudad , count(CustomerID) as Clientes from Customers GROUP by Ciudad order by Clientes desc
----------------------------------------------------------------------------------------------------------------------------------</sql><current_tab id="3"/></tab_sql></sqlb_project>
