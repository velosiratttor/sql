<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/03 Lab 2 PC 26/Downloads/DB.Browser.for.SQLite-v3.13.1-win64/Northwind.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2098"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Categories" custom_title="0" dock_id="1" table="4,10:mainCategories"/><dock_state state="000000ff00000000fd000000010000000200000485000002d5fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000004850000013200ffffff000004850000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Categories" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="82"/><column index="2" value="119"/><column index="3" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">--Se necesitan mostrar los clientes, con cantidades compradas, entre 0 y 100, ademas se necesita unicamente las ventas a partir de la fecha 1/1/1996

SELECT 
    c.CustomerID, 
    c.CustomerName, 
    o.OrderDate, 
    SUM(od.Quantity) AS TotalComprado
FROM Customers c
JOIN Orders o ON c.CustomerID = o.CustomerID
JOIN OrderDetails od ON o.OrderID = od.OrderID
WHERE o.OrderDate &gt;= '1996-01-01'
GROUP BY c.CustomerID, c.CustomerName, o.OrderDate
HAVING TotalComprado BETWEEN 0 AND 100
ORDER BY o.OrderDate DESC, TotalComprado DESC;








--Se necesita los medios de transporte de productos, con los productos y catregorias que cada uno de ellos trabaja

SELECT 
    s.ShipperID, 
    s.ShipperName, 
    p.ProductID, 
    p.ProductName, 
    c.CategoryID, 
    c.CategoryName
FROM Shippers s
JOIN Orders o ON s.ShipperID = o.ShipperID
JOIN OrderDetails od ON o.OrderID = od.OrderID
JOIN Products p ON od.ProductID = p.ProductID
JOIN Categories c ON p.CategoryID = c.CategoryID
ORDER BY s.ShipperName, c.CategoryName, p.ProductName;






--Se necesitan los proveedores con los productos, categorias que cada uno provee

SELECT 
    s.SupplierID, 
    s.SupplierName, 
    p.ProductID, 
    p.ProductName, 
    c.CategoryID, 
    c.CategoryName
FROM Suppliers s
JOIN Products p ON s.SupplierID = p.SupplierID
JOIN Categories c ON p.CategoryID = c.CategoryID
ORDER BY s.SupplierName, c.CategoryName, p.ProductName;





--se les pide mostrar el nombre del empleado las ordenes, pais del pedido, pedido el pais el transporte que lleva sus pedidos.

SELECT 
    e.FirstName, e.LastName AS Empleado, 
    o.OrderID, 
    c.Country AS PaisPedido, 
    s.Country AS PaisTransporte, 
    sh.ShipperName AS Transporte
FROM Orders o
JOIN Employees e ON o.EmployeeID = e.EmployeeID
JOIN Customers c ON o.CustomerID = c.CustomerID
JOIN Shippers sh ON o.ShipperID = sh.ShipperID
JOIN Suppliers s ON sh.ShipperID = s.SupplierID
ORDER BY e.FirstName, o.OrderID;


--se necesitan los nombres de los empleados, las ventas totales realizadas por ellos, los productos con su categoria, el medio de transporte de estos productos
--ademas del nombre del provedor de estos mismos, su pais,ciudad,direccion y telefono de contacto

SELECT 
    e.FirstName, e.LastName AS Empleado,
sum(o.OrderID) AS VentasTotales,
    p.ProductName,
    c.CategoryName,
    sh.ShipperName AS MedioTransporte,
    s.SupplierName AS Proveedor,
    s.Country,
    s.City,
    s.Address,
    s.Phone
FROM Orders o
JOIN Employees e ON o.EmployeeID = e.EmployeeID
JOIN OrderDetails od ON o.OrderID = od.OrderID
JOIN Products p ON od.ProductID = p.ProductID
JOIN Categories c ON p.CategoryID = c.CategoryID
JOIN Shippers sh ON o.ShipperID = sh.ShipperID
JOIN Suppliers s ON p.SupplierID = s.SupplierID
GROUP BY e.EmployeeID, p.ProductID, c.CategoryID, sh.ShipperID, s.SupplierID
ORDER BY Empleado, VentasTotales DESC;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
